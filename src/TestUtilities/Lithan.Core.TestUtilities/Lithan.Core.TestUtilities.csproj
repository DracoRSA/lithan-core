<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <IsTestProject>false</IsTestProject>

        <Authors>Johan Dercksen</Authors>
        <Company>Lithan Solutions</Company>
        <Product>Lithan Core</Product>
        <PackageProjectUrl>https://github.com/DracoRSA/lithan-core</PackageProjectUrl>
        <PackageTags>Lithan Test Utilities</PackageTags>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.5.0" />
        <PackageReference Include="NSubstitute" Version="6.0.0" />
        <PackageReference Include="Thuria.Zitidar.Extensions" Version="1.12.1" />
        <PackageReference Include="xunit.v3.assert" Version="3.2.2" />
    </ItemGroup>

</Project>
