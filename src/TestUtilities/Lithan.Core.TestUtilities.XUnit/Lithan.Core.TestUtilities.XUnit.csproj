<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <IsTestProject>false</IsTestProject>

        <Company>Lithan Solutions</Company>
        <Product>Lithan Core</Product>
        <PackageProjectUrl>https://github.com/DracoRSA/lithan-core</PackageProjectUrl>
        <PackageTags>Lithan Test XUnit Utilities</PackageTags>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.assert" Version="4.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lithan.Core.TestUtilities\Lithan.Core.TestUtilities.csproj" />
    </ItemGroup>

</Project>
